{
  "name": "@custos/audit-client",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./s3": {
      "types": "./dist/s3-seal-store.d.ts",
      "default": "./dist/s3-seal-store.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:s3": "vitest run src/s3-seal-store.aws.test.ts --coverage.enabled=false --mode s3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@custos/contracts": "workspace:*",
    "@custos/core": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@custos/tsconfig": "workspace:*",
    "@custos/vitest-config": "workspace:*",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  }
}
