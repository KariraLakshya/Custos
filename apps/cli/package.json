{
  "name": "@custos/cli",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "custos": "./dist/bin.js"
  },
  "main": "./src/cli.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@custos/core": "workspace:*",
    "@custos/sdk": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@custos/audit": "workspace:*",
    "@custos/connectors": "workspace:*",
    "@custos/identity": "workspace:*",
    "@custos/revocation": "workspace:*",
    "@custos/testing": "workspace:*",
    "@custos/tsconfig": "workspace:*",
    "@custos/vault": "workspace:*",
    "@custos/vitest-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
