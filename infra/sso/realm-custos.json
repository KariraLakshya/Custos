{
  "realm": "custos",
  "enabled": true,
  "sslRequired": "none",
  "groups": [{ "name": "custos-admins" }, { "name": "custos-auditors" }],
  "users": [
    {
      "username": "alice",
      "email": "alice@custos.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice-dev-password", "temporary": false }],
      "groups": ["/custos-admins"]
    },
    {
      "username": "bob",
      "email": "bob@custos.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Nogroup",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob-dev-password", "temporary": false }],
      "groups": []
    }
  ],
  "clients": [
    {
      "clientId": "custos-identity",
      "name": "Custos identity service (operator SSO, ADR 0010)",
      "enabled": true,
      "publicClient": false,
      "secret": "custos-dev-sso-client-secret-not-for-production",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4001/operator/callback",
        "http://127.0.0.1:5801/operator/callback"
      ],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
