{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateCheckAndLaterRemoveTheTestBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketVersioning",
        "s3:PutBucketObjectLockConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucketVersions",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::custos-seal-live-test-*"
    },
    {
      "Sid": "WriteReadAndTryToDeleteTestSeals",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::custos-seal-live-test-*/*"
    }
  ]
}
