{
  "name": "custos",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Custos \u2014 a trust layer for AI agents",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:mtls": "node infra/mtls/certs.mjs && node infra/mtls/render-envoy.mjs && docker compose -f infra/docker/docker-compose.yml --profile mtls up -d envoy",
    "dev:sso": "docker compose -f infra/docker/docker-compose.yml --profile sso up -d keycloak",
    "demo": "pnpm migrate && pnpm build && node apps/admin/dist/bin.js demo",
    "demo:federation": "pnpm migrate && pnpm build && node apps/admin/dist/bin.js demo-federation",
    "dev:down": "docker compose -f infra/docker/docker-compose.yml --profile mtls --profile sso --profile images down",
    "images:build": "docker compose -f infra/docker/docker-compose.yml --profile images build",
    "images:up": "bash infra/docker/images/up.sh",
    "images:down": "docker compose -f infra/docker/docker-compose.yml --profile images rm --stop --force custos-net tools dashboard vault identity revocation audit",
    "images:check": "bash infra/docker/checks/all.sh",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "migrate": "drizzle-kit migrate --config=infra/migrations/drizzle.config.ts",
    "custos-admin": "node apps/admin/dist/bin.js",
    "mtls:certs": "node infra/mtls/certs.mjs",
    "mtls:config": "node infra/mtls/render-envoy.mjs",
    "migrate:generate": "drizzle-kit generate --config=infra/migrations/drizzle.config.ts",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@custos/eslint-config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.7.2",
    "vite": "^7.1.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.6": ">=3.1.6",
      "fast-uri@>=4.0.0 <4.2.3": "^4.2.3",
      "js-yaml@<3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "undici@>=6.5.0 <6.29.1": "^6.29.1",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "vite@>=7.0.0 <7.3.7": "^7.3.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
