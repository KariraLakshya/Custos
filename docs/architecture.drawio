            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_tombstone" parent="1" style="text;html=1;fontSize=9;fontColor=#7A3510;align=center;" value="signed revocation tombstone (0.3s target)" vertex="1">
          <mxGeometry height="16" width="270" x="1230" y="495" as="geometry" />
        </mxCell>
        <mxCell id="sixQ" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#2D6CDF;fontSize=11;fontColor=#14263F;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" value="Six questions on every request:&#xa;1. Who are you? (identity / DID+VC)&#xa;2. Can I trust you? (auth / signature + not revoked)&#xa;3. What can you do? (authorization / OPA)&#xa;4. What data can you get? (data policy / field strip)&#xa;5. Can I revoke you? (lifecycle / tombstone)&#xa;6. What happened? (audit / signed record)" vertex="1">
          <mxGeometry height="170" width="360" x="80" y="680" as="geometry" />
        </mxCell>
        <mxCell id="modes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#1D9E75;fontSize=11;fontColor=#085041;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" value="Deployment modes (trust ladder):&#xa;• Self-host — data never reaches AgentID&#xa;• Hosted (metadata-only) — labels, not content&#xa;• Edge — verification only (browser/serverless)&#xa;• Hosted + TEE — inspects, provably can&#39;t exfiltrate" vertex="1">
          <mxGeometry height="120" width="700" x="80" y="860" as="geometry" />
        </mxCell>
        <mxCell id="key_hot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6F5EC;strokeColor=#1D9E75;fontSize=10;fontColor=#085041;" value="Hot path (per request)" vertex="1">
