        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14263F;align=center;verticalAlign=middle;" value="AgentID — Trust Layer for Agent-to-Agent Communication  (TLS for agentic services)" vertex="1">
          <mxGeometry height="36" width="1120" x="240" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;fontColor=#5A6B82;align=center;verticalAlign=middle;" value="Hot path (per request, &lt;10ms, in the sidecar)  ·  Cold path (setup / management, Kubernetes control plane)  ·  push, don&#39;t pull" vertex="1">
          <mxGeometry height="24" width="1120" x="240" y="56" as="geometry" />
        </mxCell>
        <mxCell id="podContainer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2D6CDF;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14263F;dashed=1;" value="AGENT POD  (customer side — hot path)" vertex="1">
          <mxGeometry height="360" width="440" x="80" y="120" as="geometry" />
        </mxCell>
        <mxCell id="agent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D6CDF;fontSize=12;fontColor=#14263F;verticalAlign=middle;" value="Agent container&#xa;(your AI agent code)&#xa;&#xa;holds NO raw API keys" vertex="1">
          <mxGeometry height="110" width="180" x="110" y="170" as="geometry" />
        </mxCell>
