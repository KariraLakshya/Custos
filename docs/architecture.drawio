        <mxCell id="svc_identity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0561F;fontSize=11;fontColor=#7A3510;verticalAlign=middle;" value="identity-svc&#xa;DID issuance · VC signing&#xa;(keys in AWS KMS)" vertex="1">
