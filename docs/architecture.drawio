        <mxCell id="e_push" edge="1" parent="1" source="cpContainer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0561F;strokeWidth=2;endArrow=classic;dashed=1;fontSize=10;fontColor=#7A3510;" target="redisLocal">
