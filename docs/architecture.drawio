        <mxCell id="key_cross" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7A3Cc9;fontSize=10;fontColor=#3C1E63;" value="Cross-org / federation" vertex="1">
