        </mxCell>
        <mxCell id="svc_kms" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE9FF;strokeColor=#7A3Cc9;fontSize=11;fontColor=#3C1E63;verticalAlign=middle;" value="AWS KMS / HSM&#xa;private keys never leave" vertex="1">
