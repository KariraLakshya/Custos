        <mxCell id="e_revoke_tools" edge="1" parent="1" source="svc_revoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0561F;strokeWidth=2;endArrow=classic;fontSize=9;fontColor=#7A3510;" target="toolsContainer">
