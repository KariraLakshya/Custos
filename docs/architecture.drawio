        </mxCell>
        <mxCell id="e_agent_sidecar" edge="1" parent="1" source="agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D9E75;strokeWidth=2;endArrow=classic;startArrow=classic;fontSize=10;fontColor=#085041;" target="sidecar">
